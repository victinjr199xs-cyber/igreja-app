{
  "expo": {
    "name": "Casa de Adoração",
    "slug": "igreja-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.casadeadoracao.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E2E2E2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.casadeadoracao.app",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#823030"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "O app adiciona os cultos e eventos da Casa de Adoração à sua agenda.",
          "remindersPermission": "O app não usa seus lembretes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O app usa suas fotos para você escolher a foto do seu perfil.",
          "cameraPermission": "O app usa a câmera para você tirar a foto do seu perfil.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#E2E2E2"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2e7f5912-204f-456a-9164-d4dc02ba8b5e"
      }
    },
    "owner": "victinjr199xs"
  }
}
