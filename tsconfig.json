{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // O TypeScript 6 não carrega mais os @types sozinho: os testes precisam
    // dos globais do Jest (describe, it, expect).
    "types": ["jest"]
  },
  // "exclude" substitui o da base: repete os padrões do Expo e soma
  // supabase/, que é código Deno (servidor), não do app.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "supabase"
  ]
}
